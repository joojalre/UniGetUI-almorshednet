<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks />
    <AssemblyName>Iciclecreek.Avalonia.WindowManager</AssemblyName>
    <PackageId>Iciclecreek.Avalonia.WindowManager</PackageId>
    <RootNamespace>Iciclecreek.Avalonia.WindowManager</RootNamespace>
    <Version>5.0.1</Version>
    <AssemblyVersion>5.0.1.0</AssemblyVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <AvaloniaResource Include="**/*.*xaml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="LICENSE;PROVENANCE.md" Link="ThirdPartyNotices/Iciclecreek.Avalonia.WindowManager/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
