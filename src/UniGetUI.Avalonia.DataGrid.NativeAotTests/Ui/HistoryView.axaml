<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Acceptance" x:Class="Acceptance.HistoryView" x:DataType="local:GridModel" x:CompileBindings="True"><DataGrid x:Name="RowsGrid" ItemsSource="{CompiledBinding Rows}" AutoGenerateColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True" SelectionMode="Single" HeadersVisibility="Column" RowHeight="36" IsReadOnly="True"><DataGrid.Columns><DataGridTemplateColumn Header="Kind" Width="150" Tag="kind"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="local:FixtureRow"><TextBlock Classes="value-Kind" Text="{CompiledBinding KindLabel}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Name" Width="150" Tag="package"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="local:FixtureRow"><TextBlock Classes="value-Name" Text="{CompiledBinding TargetName}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Version" Width="150" Tag="version"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="local:FixtureRow"><TextBlock Classes="value-Version" Text="{CompiledBinding VersionChange}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Source" Width="150" Tag="source"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="local:FixtureRow"><TextBlock Classes="value-Source" Text="{CompiledBinding SourceLabel}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Status" Width="150" Tag="status"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="local:FixtureRow"><TextBlock Classes="value-Status" Text="{CompiledBinding StatusLabel}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Date" Width="150" Tag="date"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="local:FixtureRow"><TextBlock Classes="value-Date" Text="{CompiledBinding Timestamp}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Open" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="local:FixtureRow"><Button Classes="row-open" Content="Open" IsEnabled="{CompiledBinding ExistsOnDisk}" Command="{CompiledBinding OpenCommand}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></UserControl>